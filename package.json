{
  "name": "directg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "pnpm --filter @click-b/directg-client dev",
    "dev:admin": "pnpm --filter @click-b/directg-admin dev",
    "build": "pnpm -r build",
    "build:client": "pnpm --filter @click-b/directg-client build",
    "build:admin": "pnpm --filter @click-b/directg-admin build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scaffold:module": "node packages/scripts/src/index.js create module",
    "scaffold:package": "node packages/scripts/src/index.js create package",
    "scaffold:doctor": "node packages/scripts/src/index.js doctor",
    "create-module": "node packages/scripts/src/index.js create module",
    "create-package": "node packages/scripts/src/index.js create package",
    "doctor:scripts": "node packages/scripts/src/index.js doctor",
    "config:eslint:build": "pnpm --filter @click-b/config build:eslint",
    "config:eslint:typecheck": "pnpm --filter @click-b/config typecheck:eslint",
    "typecheck": "pnpm -r --if-present typecheck",
    "prepare": "husky || true",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@click-b/config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.3",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "chalk": "^5.6.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fs-extra": "^11.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "prompts": "^2.4.2",
    "typescript": "^5.9.3"
  }
}
