# MSW mock 사용(개발 서버 포함). "true"일 때만 켜짐 (빌드 타임 값 — 변경 시 재배포 필요).
# 백엔드 API 준비 전 stage 확인용이며 운영에서는 켜지 않는다. mock 계정: admin@directg.net / 1234
VITE_ENABLE_MOCKS=false
# API base URL. 미설정 시 same-origin "/api" (빌드 타임 값). 예: https://directg-classic-api.clickb.co.kr/api
VITE_API_BASE_URL=https://directg-classic-api.clickb.co.kr/api
