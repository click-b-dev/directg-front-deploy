#php_value max_input_vars 3000

<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

RewriteEngine On
RewriteBase /

#RewriteCond %{REQUEST_URI} !^/intro/work.html$
#RewriteCond %{REQUEST_URI} !^/_Admin2_/$
#RewriteRule $ /intro/work.html [R=302,L]

#RewriteCond %{HTTP_HOST} ^www.directgames.co.kr [NC]
#RewriteCond %{HTTP_HOST} ^directgames.co.kr [NC]
#RewriteRule ^(.*)$ https://directg.net/$1 [L,R=301]

RewriteCond %{REQUEST_SCHEME} ^http$ [NC]
RewriteCond %{HTTP_HOST} !^image.directg.net [NC]
RewriteCond %{HTTP_HOST} (directg\.net|www\.directg\.net) [NC]
RewriteCond %{REQUEST_URI} !^/_Admin2_/api/postman/postman_gateway.php$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

#RewriteCond %{HTTPS} on
#RewriteCond %{HTTP_HOST} www.directgames.co.kr
#RewriteRule ^(.*)$ https://directg.net/$1 [L,R=301]

ErrorDocument 404 https://directg.net/404.html
#ErrorDocument 403 http://directgames.co.kr/403.html
#ErrorDocument 301 http://directgames.co.kr/301.html
#ErrorDocument 408 https://directg.net/408.html

RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http(s)?://(m\.)?directgames.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?directgames.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?h2interactive.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?directg.net [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?gamepara.com [NC]
RewriteCond %{HTTP_REFERER} !^https://www.directg.net [NC]
RewriteCond %{HTTP_REFERER} !^https://directgames.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^http://dev.directgames.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^https://m.directgames.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^http://m.directgames.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^http://image.directg.net [NC]
RewriteCond %{HTTP_REFERER} !^https://directg.net [NC]
RewriteCond %{HTTP_REFERER} !^http://directg.net [NC]
RewriteCond %{HTTP_REFERER} !^http://h2interactive.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^http://mail.h2interactive.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^https://mail.h2int.com [NC]
RewriteCond %{HTTP_REFERER} !^http://naver.com [NC]
RewriteCond %{HTTP_REFERER} !^http://mail.daum.net [NC]
RewriteCond %{HTTP_REFERER} !^https://mail.daum.net [NC]
RewriteCond %{HTTP_REFERER} !^https://mail.naver.com [NC]
RewriteCond %{HTTP_REFERER} !^http://mail.naver.com [NC]
RewriteCond %{HTTP_REFERER} !^http://google.com [NC]
RewriteCond %{HTTP_REFERER} !^https://mail3.nate.com [NC]
RewriteCond %{HTTP_REFERER} !^https://m.mail.nate.com [NC]
RewriteCond %{HTTP_REFERER} !^http://m.mail.daum.net [NC]
RewriteCond %{HTTP_REFERER} !^https://ezwel.directg.net [NC]
RewriteCond %{HTTP_REFERER} !^https://m.ezwel.directg.net [NC]
RewriteCond %{HTTP_REFERER} !^https://app.mail.naver.com [NC]
RewriteCond %{HTTP_REFERER} !^http://mine58.megaplug.kr [NC]
RewriteCond %{HTTP_REFERER} !^http://outlook.live.com [NC]
RewriteCond %{HTTP_REFERER} !^https://outlook.live.com [NC]
RewriteCond %{HTTP_REFERER} !^http://125.209.214.38 [NC]
RewriteCond %{HTTP_REFERER} !^http://192.168.0.109 [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?naver.com [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?nate.com [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?daum.net [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?google.co.kr [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?google.com [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?facebook.com [NC]
RewriteRule \.(gif|jpg|jpeg|png|GIF|JPG|JPEG|PNG|ICO|ico|css|CSS|SVG|svg)$ - [NC,F,L]

<FilesMatch "\.(jpg|jpeg|png|gif|swf|css|js|ico|eot|ttf|woff|woff2|svg)$">
    Header set Cache-Control "max-age=5184000, public"
</FilesMatch>


# compress text, html, javascript, css, xml:
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/x-javascript
AddOutputFilterByType DEFLATE image/svg+xml
AddOutputFilterByType DEFLATE font/woff
AddOutputFilterByType DEFLATE font/woff2
AddOutputFilterByType DEFLATE application/x-font-woff
AddOutputFilterByType DEFLATE application/x-font-woff2
AddOutputFilterByType DEFLATE image/x-icon

# Or, compress certain file types by extension:
<files *.html>
SetOutputFilter DEFLATE
</files>

<Files xmlrpc.php>
order deny,allow
deny from all
</Files>

